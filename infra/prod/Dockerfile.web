# Production image for apps/web. Build context = repository root:
#   docker compose -f infra/prod/docker-compose.yml build web
# Multi-stage: install workspace deps -> build @seap/db + next standalone ->
# copy only the traced server bundle into a slim runtime image.

FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@9.4.0 --activate
WORKDIR /app

# ---- deps: workspace manifests only, so this layer caches across code edits
FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/
COPY apps/ingestion/package.json apps/ingestion/
COPY packages/db/package.json packages/db/
COPY packages/domain/package.json packages/domain/
COPY packages/scraper-clients/package.json packages/scraper-clients/
RUN pnpm install --frozen-lockfile --filter web...

# ---- build
FROM deps AS build
COPY tsconfig.base.json ./
COPY packages/db packages/db
COPY apps/web apps/web
ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm --filter @seap/db build && pnpm --filter web build

# ---- runtime
FROM node:22-alpine AS runner
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0 PORT=3000
WORKDIR /app
COPY --from=build --chown=node:node /app/apps/web/.next/standalone ./
COPY --from=build --chown=node:node /app/apps/web/.next/static ./apps/web/.next/static
USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3000/robots.txt >/dev/null || exit 1
CMD ["node", "apps/web/server.js"]
