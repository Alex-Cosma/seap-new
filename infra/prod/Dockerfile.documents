FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends chromium poppler-utils tesseract-ocr tesseract-ocr-ron tesseract-ocr-eng openssl ca-certificates && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@9.4.0 --activate
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/web/package.json apps/web/
COPY apps/ingestion/package.json apps/ingestion/
COPY packages/db/package.json packages/db/
COPY packages/domain/package.json packages/domain/
COPY packages/scraper-clients/package.json packages/scraper-clients/
RUN pnpm install --frozen-lockfile --filter web...
COPY packages/db packages/db
COPY apps/web apps/web
RUN pnpm --filter @seap/db build
ENV DOCUMENTS_CHROMIUM=/usr/bin/chromium NODE_ENV=production
USER node
CMD ["node", "apps/web/node_modules/tsx/dist/cli.mjs", "apps/web/scripts/documents/worker.ts"]
