# One-off owner-privileged migration process; the web image stays unprivileged.
FROM node:22-bookworm-slim
RUN corepack enable && corepack prepare pnpm@9.4.0 --activate
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/db/package.json packages/db/
RUN pnpm install --frozen-lockfile --filter @seap/db --prod
COPY packages/db/migrations packages/db/migrations
COPY packages/db/scripts/deploy-migrate.mjs packages/db/scripts/deploy-migrate.mjs
COPY packages/db/scripts/migration-history.mjs packages/db/scripts/migration-history.mjs
COPY infra/prod/app-grants.sql infra/prod/app-grants.sql
USER node
CMD ["node", "packages/db/scripts/deploy-migrate.mjs"]
