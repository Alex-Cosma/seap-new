# Copy to .env (same directory) and fill in. Generate secrets with:
#   openssl rand -base64 32
DOMAIN=cinecastiga.ro

POSTGRES_PASSWORD=
SEAP_WEB_PASSWORD=
MEILI_MASTER_KEY=
BETTER_AUTH_SECRET=

# Outbound mail for login codes (2FA). Leave SMTP_HOST empty to log codes to
# `docker compose logs web` instead of sending (fine for the first smoke test).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=cinecastiga? <noreply@cinecastiga.ro>

DATA_AS_OF=2026-07-31
DATA_MODE=snapshot
