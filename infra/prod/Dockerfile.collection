FROM node:22-bookworm-slim
RUN corepack enable && corepack prepare pnpm@9.4.0 --activate
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/web/package.json apps/web/
COPY apps/ingestion/package.json apps/ingestion/
COPY packages/db/package.json packages/db/
COPY packages/domain/package.json packages/domain/
COPY packages/scraper-clients/package.json packages/scraper-clients/
RUN pnpm install --frozen-lockfile --filter ingestion...
COPY packages/db packages/db
COPY packages/domain packages/domain
COPY packages/scraper-clients packages/scraper-clients
COPY apps/ingestion apps/ingestion
COPY scripts/proxies scripts/proxies
RUN pnpm --filter @seap/db build && pnpm --filter @seap/domain build && pnpm --filter @seap/scraper-clients build && pnpm --filter ingestion build
ENV NODE_ENV=production
USER node
CMD ["node", "apps/ingestion/dist/scripts/collection.js", "run"]
