  "components": [
    {
      "name": "Monitoring Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The immediate committing action in a monitoring form.",
      "html": "<button class=\"ds-primary\" type=\"button\">Începe urmărirea</button>",
      "css": ".ds-primary{font:600 13px var(--body,\"IBM Plex Sans\",sans-serif);background:var(--accent);color:var(--on-accent);border:1px solid var(--accent);border-radius:7px;padding:11px 18px;min-height:44px;cursor:pointer;transition:background .16s ease,border-color .16s ease}.ds-primary:hover{background:var(--ink)}.ds-primary:focus-visible{outline:2px solid var(--accent);outline-offset:4px}.ds-primary:disabled{opacity:.6;cursor:wait}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
    },
    {
      "name": "Monitoring Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "A secondary action such as reloading an available list.",
      "html": "<button class=\"ds-secondary\" type=\"button\">Reîncarcă lista</button>",
      "css": ".ds-secondary{font:400 13px var(--body,\"IBM Plex Sans\",sans-serif);background:var(--surface);color:var(--accent);border:1px solid var(--line2);border-radius:7px;padding:9px 15px;min-height:42px;cursor:pointer;transition:background .16s ease,border-color .16s ease}.ds-secondary:hover{background:var(--sunk);border-color:var(--accent-line)}.ds-secondary:focus-visible{outline:2px solid var(--accent);outline-offset:4px}.ds-secondary:disabled{opacity:.6;cursor:wait}@media(prefers-reduced-motion:reduce){.ds-secondary{transition:none}}"
    },
    {
      "name": "Labeled Monitoring Input",
      "kind": "input",
      "refersTo": "input",
      "description": "A visible Romanian label and a surface field.",
      "html": "<label class=\"ds-field\">Numele urmăririi<input type=\"text\" value=\"Lucrări locale\" /></label>",
      "css": ".ds-field{display:grid;gap:7px;font:600 13px var(--body,\"IBM Plex Sans\",sans-serif);color:var(--ink)}.ds-field input{box-sizing:border-box;font:400 14px var(--body,\"IBM Plex Sans\",sans-serif);width:100%;min-width:0;padding:11px 12px;background:var(--surface);border:1px solid var(--line2);border-radius:6px;color:var(--ink)}.ds-field input:focus-visible{outline:2px solid var(--accent);outline-offset:4px}"
    },
    {
      "name": "Shared Header Navigation",
      "kind": "nav",
      "description": "The site header destinations; the current section carries the accent and its underline, and aria-current states it.",
      "html": "<nav class=\"ds-main-nav\" aria-label=\"Navigare principală\"><a href=\"#descopera\">Descoperă</a><a href=\"#intreaba\" class=\"on\" aria-current=\"page\">Întreabă</a><a href=\"#ghid\">Ghid</a></nav>",
      "css": ".ds-main-nav{display:flex;gap:29px;height:56px;border-bottom:1px solid var(--line);font:400 13px var(--body,\"IBM Plex Sans\",sans-serif)}.ds-main-nav a{position:relative;display:flex;align-items:center;gap:7px;color:var(--muted);text-decoration:none;white-space:nowrap}.ds-main-nav a:hover{color:var(--ink)}.ds-main-nav a.on{color:var(--accent)}.ds-main-nav a.on:after{content:\"\";position:absolute;left:0;right:0;bottom:-1px;height:3px;background:var(--accent)}.ds-main-nav a:focus-visible{outline:2px solid var(--accent);outline-offset:2px}"
    },
    {
      "name": "Private Workspace Navigation",
      "kind": "nav",
      "description": "Existing local destinations beneath the shared header; current state stays explicit.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Spațiu privat\"><a href=\"#investigations\">Anchetele mele</a><a href=\"#monitoring\" aria-current=\"page\">Urmăriri</a></nav>",
      "css": ".ds-nav{display:flex;gap:24px;font:400 14px var(--body,\"IBM Plex Sans\",sans-serif)}.ds-nav a{color:var(--accent);text-decoration:none;text-underline-offset:5px}.ds-nav a:hover{text-decoration:underline}.ds-nav a[aria-current=page]{border-bottom:2px solid var(--accent);padding-bottom:7px}.ds-nav a:focus-visible{outline:2px solid var(--accent);outline-offset:4px}"
    },
    {
      "name": "Source Change Status",
      "kind": "chip",
      "refersTo": "status-chip",
      "description": "Text communicates the record state independently of its accent tint.",
      "html": "<span class=\"ds-status\">Date modificate</span>",
      "css": ".ds-status{display:inline-block;padding:3px 9px;background:var(--accent-soft);color:var(--accent-ink);border-radius:4px;font:400 11px var(--body,\"IBM Plex Sans\",sans-serif)}"
    },
    {
      "name": "Preserved Before and After Evidence",
      "kind": "card",
      "refersTo": "evidence-panel",
      "description": "The existing investigation evidence panel with two frozen source actions.",
      "html": "<section class=\"ds-evidence\"><strong>Ambele versiuni sunt păstrate</strong><p>Înregistrările afectate rămân exact cum au fost observate.</p><div><a href=\"#before\">Sursele înainte</a><a href=\"#after\">Sursele după</a></div></section>",
      "css": ".ds-evidence{padding:16px 18px;background:var(--sunk);color:var(--ink);border-radius:8px;font:400 13px/1.6 var(--body,\"IBM Plex Sans\",sans-serif)}.ds-evidence strong{font-weight:600}.ds-evidence p{margin:8px 0;color:var(--muted)}.ds-evidence>div{display:flex;gap:16px;flex-wrap:wrap;margin-top:14px}.ds-evidence a{font-size:14px;font-weight:600;color:var(--accent);text-decoration:none;text-underline-offset:4px}.ds-evidence a:hover{text-decoration:underline}.ds-evidence a:focus-visible{outline:2px solid var(--accent);outline-offset:4px}"
    },
    {
      "name": "Floating Loading Status",
      "kind": "custom",
      "description": "Loading over an answer already on screen: in the app it is fixed under the sticky header (top: header height + 12px, centred) so the page never moves; shown here in place.",
      "html": "<div class=\"ds-loader\" role=\"status\" aria-live=\"polite\"><span class=\"ds-bars\" aria-hidden=\"true\"><i></i><i></i><i></i></span><span>Căutăm răspunsul în date…</span></div>",
      "css": ".ds-loader{display:inline-flex;align-items:center;gap:10px;max-width:calc(100vw - 32px);box-sizing:border-box;padding:9px 16px;border:1px solid var(--line2);border-radius:18px;background:var(--surface);color:var(--ink2);font:400 13px/1.4 var(--body,\"IBM Plex Sans\",sans-serif);box-shadow:var(--shadow2)}.ds-bars{display:inline-flex;align-items:flex-end;gap:3px;height:16px}.ds-bars i{width:4px;height:100%;border-radius:2px;background:var(--accent);transform-origin:bottom;animation:ds-bar .9s ease-in-out infinite}.ds-bars i:nth-child(2){animation-delay:.15s}.ds-bars i:nth-child(3){animation-delay:.3s}@keyframes ds-bar{0%,100%{transform:scaleY(.25);opacity:.55}50%{transform:scaleY(1);opacity:1}}@media(prefers-reduced-motion:reduce){.ds-bars i{animation:none;transform:scaleY(.6)}}"
    }
