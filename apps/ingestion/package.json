{
  "name": "ingestion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/index.ts",
    "scrape": "tsx src/scripts/scrape.ts",
    "scrape-ted": "tsx src/scripts/scrape-ted.ts",
    "scrape-ted-bulk": "tsx src/scripts/scrape-ted-bulk.ts",
    "verify-da": "tsx src/scripts/verify-da-completeness.ts",
    "scrub-pii": "tsx src/scripts/scrub-pii.ts",
    "start": "node dist/index.js",
    "test": "vitest run --exclude '**/*.integration.test.ts' --passWithNoTests",
    "test:integration": "vitest run integration.test",
    "lint": "tsc -p tsconfig.json --noEmit",
    "normalize": "tsx src/scripts/normalize.ts",
    "reconcile": "tsx src/scripts/reconcile.ts",
    "merge-exact-name": "tsx src/scripts/merge-exact-name.ts",
    "marts": "tsx src/scripts/marts.ts",
    "ted-mart": "tsx src/scripts/ted-mart.ts",
    "import-old": "tsx src/scripts/import-old.ts",
    "index-search": "tsx src/scripts/index-search.ts",
    "import-das": "tsx src/scripts/import-das.ts",
    "import-financials": "tsx src/scripts/import-financials.ts",
    "import-onrc": "tsx src/scripts/import-onrc.ts",
    "seed-thresholds": "tsx src/scripts/seed-thresholds.ts",
    "flags": "tsx src/scripts/flags.ts",
    "radiografie": "tsx src/scripts/radiografie.ts",
    "reset-derived": "tsx src/scripts/reset-derived.ts"
  },
  "dependencies": {
    "@seap/db": "workspace:*",
    "@seap/domain": "workspace:*",
    "@seap/scraper-clients": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^4.5.0",
    "graphile-worker": "^0.16.6",
    "meilisearch": "^0.59.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
